# Copy to .env.local and fill in. Never commit real values.
# Both database URLs must point at a Neon DEVELOPMENT branch, never production.

# Neon pooled connection string (host contains "-pooler"); used by the app
DATABASE_URL=
# Neon direct connection string (same branch, no "-pooler"); used by Prisma CLI / migrations
DIRECT_URL=

# openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional: Google sign-in (button hidden unless both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Every.org Nonprofits API public key (admin import and the weekly refresh)
EVERY_ORG_PUBLIC_KEY=

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"; /api/cron routes refuse
# everything without it. At least 32 characters: openssl rand -hex 32
CRON_SECRET=

# Milestone 3 groundwork (never active on Vercel production yet; see src/lib/checkout.ts).
# DONATIONS_CHECKOUT_ENABLED=true sends donors to Every.org's Donate Link to pay.
DONATIONS_CHECKOUT_ENABLED=
# staging.every.org (default, test card 4242 4242 4242 4242) or www.every.org
EVERYORG_DONATE_HOST=
# Every.org's webhook_token (Every.org developer dashboard). A ROUTING value, not a secret:
# it goes into every Donate Link, so donors can see it. Never use it to authenticate.
EVERYORG_WEBHOOK_TOKEN=
# The bearer token Every.org sends as "Authorization: Bearer <token>" with each partner
# webhook. SECRET, server-only (never NEXT_PUBLIC_). At least 32 characters, or every
# webhook is refused. Locally: the STAGING account's token. Production: Vercel Production only.
EVERYORG_WEBHOOK_SECRET=
# Only while rotating the token: the new value, accepted alongside the old one.
EVERYORG_WEBHOOK_SECRET_NEXT=
# Optional: Charity Navigator Data API key (developer.charitynavigator.org).
# When set, the weekly refresh also updates each organization's CN rating.
CHARITY_NAVIGATOR_API_KEY=
