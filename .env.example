# Copy to .env.local and fill in. Never commit real values.
# Both database URLs must point at a Neon DEVELOPMENT branch, never production.

# Neon pooled connection string (host contains "-pooler"); used by the app
DATABASE_URL=
# Neon direct connection string (same branch, no "-pooler"); used by Prisma CLI / migrations
DIRECT_URL=

# openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional: Google sign-in (button hidden unless both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Every.org Nonprofits API public key (admin import and the weekly refresh)
EVERY_ORG_PUBLIC_KEY=

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"; /api/cron routes refuse
# everything without it. At least 32 characters: openssl rand -hex 32
CRON_SECRET=

# Milestone 3: giving through Every.org (src/lib/checkout.ts). Never active on Vercel
# Production (until go-live) or Preview (it uses the production database).
# DONATIONS_CHECKOUT_ENABLED=true sends donors to Every.org's Donate Link to pay.
DONATIONS_CHECKOUT_ENABLED=
# staging.every.org (default, test card 4242 4242 4242 4242) or www.every.org.
# Staging and production are separate Every.org accounts, so each has its own variables:
EVERYORG_DONATE_HOST=
#
# --- Staging (local only; never in Vercel) ---
# webhook_token from the STAGING developer dashboard. A ROUTING value, not a secret: it goes
# into every Donate Link, so donors can see it. Without it Every.org sends no webhook.
EVERYORG_STAGING_WEBHOOK_TOKEN=
# The bearer token Every.org's STAGING webhook sends as "Authorization: Bearer <token>".
# SECRET, server-only (never NEXT_PUBLIC_). At least 32 characters, or every webhook is refused.
EVERYORG_STAGING_WEBHOOK_SECRET=
# Staging API key: not used by the app (Donate Links and the webhook need no key).
# EVERYORG_STAGING_API_KEY=
#
# --- Production (www.every.org; Vercel Production only, at go-live) ---
EVERYORG_WEBHOOK_TOKEN=
EVERYORG_WEBHOOK_SECRET=
# Only while rotating a token: the new value, accepted alongside the old one
# (EVERYORG_STAGING_WEBHOOK_SECRET_NEXT for staging).
EVERYORG_WEBHOOK_SECRET_NEXT=
# Optional: Charity Navigator Data API key (developer.charitynavigator.org).
# When set, the weekly refresh also updates each organization's CN rating.
CHARITY_NAVIGATOR_API_KEY=
