// =======================================================
//  Prisma Schema — The Penny Effect
// =======================================================

generator client {
  // Prisma 7's generator. The client is generated into src/generated/prisma
  // (git-ignored; `prisma generate` runs on install and in `pnpm build`).
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URLs live outside the schema in Prisma 7:
  // - app at runtime: DATABASE_URL (pooled), via the Neon adapter in src/lib/prisma.ts
  // - Prisma CLI (migrate, studio): DIRECT_URL, via prisma.config.ts
}

// =======================================================
//  User Authentication & Sessions
// =======================================================

// ADMIN can import, verify and hide organizations and post news (/admin).
// Granted by hand in the Neon console; there is no UI to become an admin.
enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   @db.Text
  handle        String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts              Account[]
  sessions              Session[]
  donations             Donation[]
  interests             UserInterest[]
  // Organizations this user follows (D-019, Local plan L1).
  follows               OrganizationFollow[]
  location              UserLocation?
  avatar                UserAvatar?
  // Organizations this user (an admin) reviewed and verified.
  verifiedOrganizations Organization[]       @relation("OrganizationVerifiedBy")

  // Flags
  hasCompletedOnboarding Boolean @default(false)
  role                   Role    @default(USER)

  // Profile (Milestone 3.5). Private to the user for now: no page shows
  // these to anyone else, but they're stored so a public view could be
  // added later. `bio` is plain text, at most 500 characters
  // (src/lib/profile.ts), never rendered as HTML or markdown.
  bio              String? @db.Text
  // "Show my name in collective totals". Default anonymous. Nothing reads
  // it yet; collective totals (Milestone 4) must respect it.
  showNameInTotals Boolean @default(false)

  // "My area" (local nonprofits, D-028): chosen by the user, coarse only,
  // never a street address. Either a region, or a city with its state, or
  // nothing (the default). A database CHECK keeps it to one of those.
  // Used for the feed's Near me tab and Discover's "Use my area".
  areaRegionId String?
  areaRegion   Region? @relation(fields: [areaRegionId], references: [id], onDelete: SetNull)
  areaCity     String?
  // Two-letter USPS code, set together with areaCity.
  areaState    String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =======================================================
//  Donations & Organizations
// =======================================================

// Lifecycle of a gift. Today nothing is charged, so every donation stays
// PENDING. With the donation partner (Milestone 3), it becomes COMPLETED or
// FAILED only from the partner's server-side confirmation.
enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  // Set only from a verified Every.org webhook about a COMPLETED gift (M3-PLAN §2).
  // Neither counts as "given".
  REFUNDED
  DISPUTED
}

model Donation {
  id             String         @id @default(cuid())
  // Integer cents (D-004). The legacy dollar float `amount` was dropped.
  amountCents    Int
  currency       String         @default("USD")
  status         DonationStatus @default(PENDING)
  // The donation partner's reference for this gift (Milestone 3).
  externalId     String?        @unique
  // Sent by the donation form (a UUID per gift) so a double-click or retry
  // can't record the same gift twice. Null for rows from before this column.
  idempotencyKey String?
  // Milestone 3 (M3-PLAN, D-014): our id for this gift at Every.org, sent as
  // partner_donation_id in the Donate Link and echoed back by the webhook.
  // Random, server-generated, set when checkout starts. The donor can see it
  // (it's in the link), so it is never proof of payment on its own.
  checkoutToken  String?        @unique
  // What the donor was sent to pay, frozen at checkout (the webhook must match it).
  checkoutEin    String?
  checkoutSlug   String?
  // Set only by Every.org's verified webhook (src/lib/everyorg-webhook):
  // when it confirmed the payment, what reached the nonprofit after fees,
  // and how the donor paid.
  completedAt    DateTime?
  netAmountCents Int?
  paymentMethod  String?
  message        String?
  createdAt      DateTime       @default(now())

  // Foreign keys. `userId` is null once the donor deletes their account: the
  // gift stays for accounting (amount, organization, status, partner ids)
  // but no longer points to a person (src/lib/account-store.ts).
  userId         String?
  organizationId String
  // When the donor's account was deleted (and this row anonymized).
  userDeletedAt  DateTime?

  // Relations
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id])

  // One donation per (user, idempotency key). Postgres allows many NULL keys.
  @@unique([userId, idempotencyKey])
}

// Where an organization's Charity Navigator rating came from (D-016).
enum RatingSource {
  API
  MANUAL
}

// Who an organization serves (local nonprofits, D-028). Set by an admin.
// Discover lists national organizations in their own section, so local ones
// aren't buried under them.
enum ServiceArea {
  LOCAL // one city or community
  REGIONAL // several cities or counties
  STATEWIDE // the whole state it's based in
  NATIONAL // the whole country, or beyond
}

// Organizations are hidden, never deleted, so donation history stays intact.
enum OrganizationStatus {
  ACTIVE
  HIDDEN
}

// Users see an organization only when it is ACTIVE, has an EIN, Every.org
// reports it disbursable, and an admin has verified it (D-012).
model Organization {
  id                String       @id @default(cuid())
  // Display name. Not unique: the EIN is the identity.
  name              String
  description       String?
  website           String?
  logoUrl           String?
  locationCity      String?
  locationState     String?
  locationCountry   String?
  // From Every.org's address on import and in the weekly refresh
  // (src/lib/everyorg/address.ts): city as written, 2-letter state, 5-digit ZIP.
  locationZip       String?
  // County name without the word "County" (e.g. "Palm Beach"), entered by an
  // admin (Every.org has no county). With locationState, it's what matches
  // regions (src/lib/area.ts).
  locationCounty    String?
  // An admin set city/state/ZIP by hand, so the Every.org refresh leaves them alone.
  locationManual    Boolean      @default(false)
  // Null until an admin sets it (required to verify from now on).
  serviceArea       ServiceArea?
  // Volunteering (D-028). The link is shown only when it's a valid http(s) URL.
  acceptsVolunteers Boolean      @default(false)
  volunteerUrl      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // US registry ID: 9 digits, no dash (e.g. "123456789").
  ein           String?   @unique
  // Every.org's identifiers (Nonprofits API `id` and `primarySlug`).
  everyOrgId    String?   @unique
  everyOrgSlug  String?   @unique
  // Every.org can send donations to it. Copied from Every.org on import/sync.
  isDisbursable Boolean   @default(false)
  nteeCode      String?
  coverImageUrl String?
  // When we last refreshed details from Every.org.
  lastSyncedAt  DateTime?

  // Charity Navigator rating (D-016): an interim quality signal about how a
  // charity is run, not its impact per dollar. Shown as-is with attribution
  // and a link; CN's terms forbid using it in other calculations.
  cnScore      Int? // Encompass score, 0-100
  cnStars      Int? // 0-4 stars, as published by CN
  cnProfileUrl String?
  cnCheckedAt  DateTime? // when we last read it (older than ~6 months shows as stale)
  cnSource     RatingSource?

  // Admin review (D-012). Both set together when an admin verifies.
  verifiedAt       DateTime?
  verifiedById     String?
  // Why the admin verified it (what they checked), shown to other admins.
  // Required when verifying from now on; NULL for orgs verified before notes
  // existed. Cleared together with verifiedAt.
  verificationNote String?   @db.Text
  verifiedBy       User?     @relation("OrganizationVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  status OrganizationStatus @default(ACTIVE)

  // Relations
  donations  Donation[]
  categories CauseCategory[]      @relation("OrgCategories")
  newsItems  NewsItem[]
  followers  OrganizationFollow[]
}

// =======================================================
//  Causes & User Interests
// =======================================================

model CauseCategory {
  id            String         @id @default(cuid())
  name          String         @unique
  // URL-safe key, e.g. "space-science" (Discover uses ?category=<slug>; the
  // Every.org cause mapping in src/lib/causes.ts is keyed by it).
  slug          String         @unique
  description   String?
  subcauses     SubCause[]
  organizations Organization[] @relation("OrgCategories")
  userInterests UserInterest[]
}

model SubCause {
  id            String         @id @default(cuid())
  name          String
  categoryId    String
  category      CauseCategory  @relation(fields: [categoryId], references: [id])
  userInterests UserInterest[]
}

model UserInterest {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  subcauseId String?
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id])
  category CauseCategory @relation(fields: [categoryId], references: [id])
  subcause SubCause?     @relation(fields: [subcauseId], references: [id])

  // A user follows each category at most once.
  @@unique([userId, categoryId])
}

// =======================================================
//  User Location (optional)
// =======================================================

model UserLocation {
  id        String  @id @default(cuid())
  userId    String  @unique
  city      String?
  state     String?
  country   String?
  latitude  Float?
  longitude Float?

  user User @relation(fields: [userId], references: [id])
}

// A named area made of counties, e.g. "South Florida" = Palm Beach, Broward
// and Miami-Dade (local nonprofits, D-028). Data, not code: the first four
// were inserted by the migration that added this table; admins add more at
// /admin/regions. Organizations match a region by their county and state.
model Region {
  id        String         @id @default(cuid())
  // URL key for Discover's ?area= (at least 3 characters, so it can't be read as a state code).
  slug      String         @unique
  name      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  counties  RegionCounty[]
  // Users who chose this region as My area (set to none if it's deleted).
  users     User[]
}

model RegionCounty {
  regionId String
  // Two-letter USPS code.
  state    String
  // As shown, without "County" (e.g. "Miami-Dade").
  county   String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([regionId, state, county])
}

// news items
model NewsItem {
  id             String       @id @default(cuid())
  title          String
  content        String
  /// Link to where the organization published this update. The feed shows
  /// only items that have one, so nothing appears without a real source.
  sourceUrl      String?
  /// The update's image: a URL only (we never copy the file), usually the
  /// source page's og:image. Served through /media/news/<id>, which only
  /// serves URLs stored here. Shown with "Image: <source site>" credit.
  imageUrl       String?
  /// Alt text, required whenever there's an image.
  imageAlt       String?
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

// Audit log of every authenticated webhook call from a donation partner
// (M3-PLAN §2). Requests without the right bearer token are never stored.
// `payload` keeps an allowlist of fields only: no donor name, email,
// address or notes (D-014 update, data terms pending).
model PartnerEvent {
  id                String             @id @default(cuid())
  provider          String             @default("EVERYORG")
  kind              PartnerEventKind
  status            PartnerEventStatus
  reason            String?
  // Every.org's charge id and our checkoutToken, as sent (may be missing on bad payloads).
  chargeId          String?
  partnerDonationId String?
  // The donation this event matched, if any. Plain id, no foreign key, so the
  // audit row survives whatever happens to the donation.
  donationId        String?
  payload           Json?
  receivedAt        DateTime           @default(now())

  // A retried webhook is stored once. Postgres allows many NULL chargeIds.
  @@unique([provider, kind, chargeId])
  @@index([status, receivedAt])
  @@index([donationId])
}

enum PartnerEventKind {
  DONATION
  REFUND
  DISPUTE
  UNKNOWN
}

enum PartnerEventStatus {
  APPLIED // changed a donation
  DUPLICATE // already applied earlier; nothing changed
  REJECTED // didn't match our records; nothing changed (admin should look)
  IGNORED // not an event we act on; nothing changed
}

// Fixed-window rate-limit counters (D-018). One row per (rule, who, window).
// `keyHash` is an HMAC of the IP, email or user id, never the raw value.
// Expired rows are deleted by the weekly cron.
model RateLimitHit {
  bucket      String
  keyHash     String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  @@id([bucket, keyHash, windowStart])
  @@index([expiresAt])
}

// A user following one organization (Local plan L1, D-019). Private: never
// shown to other users or to the organization. Admins see only a count.
// Hiding an organization keeps its follows; they show again if it's unhidden.
model OrganizationFollow {
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}

// A user's uploaded profile picture (Milestone 3.5). Always a 256×256 WebP
// that our server made from the upload (src/lib/avatar-image.ts): resized,
// cropped to a square and re-encoded, which also drops the original's
// metadata (camera, GPS location). A few KB, so it lives in Postgres and
// needs no file-storage service. Its own table, so loading a User never
// loads the image. Served only to its owner for now (/api/profile/avatar).
// Deleted with the user.
model UserAvatar {
  userId    String   @id
  data      Bytes
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
