// =======================================================
//  Prisma Schema — The Penny Effect
// =======================================================

generator client {
  // Prisma 7's generator. The client is generated into src/generated/prisma
  // (git-ignored; `prisma generate` runs on install and in `pnpm build`).
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URLs live outside the schema in Prisma 7:
  // - app at runtime: DATABASE_URL (pooled), via the Neon adapter in src/lib/prisma.ts
  // - Prisma CLI (migrate, studio): DIRECT_URL, via prisma.config.ts
}

// =======================================================
//  User Authentication & Sessions
// =======================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   @db.Text
  handle        String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts  Account[]
  sessions  Session[]
  donations Donation[]
  interests UserInterest[]
  location  UserLocation?

  // Flags
  hasCompletedOnboarding Boolean @default(false)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =======================================================
//  Donations & Organizations
// =======================================================

// Lifecycle of a gift. Today nothing is charged, so every donation stays
// PENDING. With the donation partner (Milestone 3), it becomes COMPLETED or
// FAILED only from the partner's server-side confirmation.
enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
}

model Donation {
  id          String         @id @default(cuid())
  // LEGACY: dollars as a float. Still written for the previous deployment's
  // sake; read `amountCents` instead. Dropped in a follow-up migration
  // (add-then-remove), when `amountCents` also becomes required.
  amount      Float
  // Integer cents (D-004). Nullable only until the follow-up migration.
  amountCents Int?
  currency    String         @default("USD")
  status      DonationStatus @default(PENDING)
  // The donation partner's reference for this gift (Milestone 3).
  externalId  String?        @unique
  message     String?
  createdAt   DateTime       @default(now())

  // Foreign keys
  userId         String
  organizationId String

  // Relations
  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
}

model Organization {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String?
  website         String?
  logoUrl         String?
  cryptoWalletBTC String?
  cryptoWalletETH String?
  locationCity    String?
  locationState   String?
  locationCountry String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  donations  Donation[]
  categories CauseCategory[] @relation("OrgCategories")
  newsItems  NewsItem[]
}

// =======================================================
//  Causes & User Interests
// =======================================================

model CauseCategory {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  subcauses     SubCause[]
  organizations Organization[] @relation("OrgCategories")
  userInterests UserInterest[]
}

model SubCause {
  id            String         @id @default(cuid())
  name          String
  categoryId    String
  category      CauseCategory  @relation(fields: [categoryId], references: [id])
  userInterests UserInterest[]
}

model UserInterest {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  subcauseId String?
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id])
  category CauseCategory @relation(fields: [categoryId], references: [id])
  subcause SubCause?     @relation(fields: [subcauseId], references: [id])

  // A user follows each category at most once.
  @@unique([userId, categoryId])
}

// =======================================================
//  User Location (optional)
// =======================================================

model UserLocation {
  id        String  @id @default(cuid())
  userId    String  @unique
  city      String?
  state     String?
  country   String?
  latitude  Float?
  longitude Float?

  user User @relation(fields: [userId], references: [id])
}

// news items
model NewsItem {
  id             String       @id @default(cuid())
  title          String
  content        String
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}
