// =======================================================
//  Prisma Schema — The Penny Effect
// =======================================================

generator client {
  // Prisma 7's generator. The client is generated into src/generated/prisma
  // (git-ignored; `prisma generate` runs on install and in `pnpm build`).
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URLs live outside the schema in Prisma 7:
  // - app at runtime: DATABASE_URL (pooled), via the Neon adapter in src/lib/prisma.ts
  // - Prisma CLI (migrate, studio): DIRECT_URL, via prisma.config.ts
}

// =======================================================
//  User Authentication & Sessions
// =======================================================

// ADMIN can import, verify and hide organizations and post news (/admin).
// Granted by hand in the Neon console; there is no UI to become an admin.
enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   @db.Text
  handle        String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts  Account[]
  sessions  Session[]
  donations Donation[]
  interests UserInterest[]
  location  UserLocation?
  // Organizations this user (an admin) reviewed and verified.
  verifiedOrganizations Organization[] @relation("OrganizationVerifiedBy")

  // Flags
  hasCompletedOnboarding Boolean @default(false)
  role                   Role    @default(USER)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =======================================================
//  Donations & Organizations
// =======================================================

// Lifecycle of a gift. Today nothing is charged, so every donation stays
// PENDING. With the donation partner (Milestone 3), it becomes COMPLETED or
// FAILED only from the partner's server-side confirmation.
enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
}

model Donation {
  id             String         @id @default(cuid())
  // Integer cents (D-004). The legacy dollar float `amount` was dropped.
  amountCents    Int
  currency       String         @default("USD")
  status         DonationStatus @default(PENDING)
  // The donation partner's reference for this gift (Milestone 3).
  externalId     String?        @unique
  // Sent by the donation form (a UUID per gift) so a double-click or retry
  // can't record the same gift twice. Null for rows from before this column.
  idempotencyKey String?
  // Milestone 3 (M3-PLAN, D-014): our id for this gift at Every.org, sent as
  // partner_donation_id in the Donate Link and echoed back by the webhook.
  // Random, server-generated, set when checkout starts. The donor can see it
  // (it's in the link), so it is never proof of payment on its own.
  checkoutToken  String?        @unique
  // What the donor was sent to pay, frozen at checkout (the webhook must match it).
  checkoutEin    String?
  checkoutSlug   String?
  message        String?
  createdAt      DateTime       @default(now())

  // Foreign keys
  userId         String
  organizationId String

  // Relations
  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  // One donation per (user, idempotency key). Postgres allows many NULL keys.
  @@unique([userId, idempotencyKey])
}

// Where an organization's Charity Navigator rating came from (D-016).
enum RatingSource {
  API
  MANUAL
}

// Organizations are hidden, never deleted, so donation history stays intact.
enum OrganizationStatus {
  ACTIVE
  HIDDEN
}

// Users see an organization only when it is ACTIVE, has an EIN, Every.org
// reports it disbursable, and an admin has verified it (D-012).
model Organization {
  id              String   @id @default(cuid())
  // Display name. Not unique: the EIN is the identity.
  name            String
  description     String?
  website         String?
  logoUrl         String?
  locationCity    String?
  locationState   String?
  locationCountry String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // US registry ID: 9 digits, no dash (e.g. "123456789").
  ein           String?   @unique
  // Every.org's identifiers (Nonprofits API `id` and `primarySlug`).
  everyOrgId    String?   @unique
  everyOrgSlug  String?   @unique
  // Every.org can send donations to it. Copied from Every.org on import/sync.
  isDisbursable Boolean   @default(false)
  nteeCode      String?
  coverImageUrl String?
  // When we last refreshed details from Every.org.
  lastSyncedAt  DateTime?

  // Charity Navigator rating (D-016): an interim quality signal about how a
  // charity is run, not its impact per dollar. Shown as-is with attribution
  // and a link; CN's terms forbid using it in other calculations.
  cnScore      Int? // Encompass score, 0-100
  cnStars      Int? // 0-4 stars, as published by CN
  cnProfileUrl String?
  cnCheckedAt  DateTime? // when we last read it (older than ~6 months shows as stale)
  cnSource     RatingSource?

  // Admin review (D-012). Both set together when an admin verifies.
  verifiedAt   DateTime?
  verifiedById String?
  // Why the admin verified it (what they checked), shown to other admins.
  // Required when verifying from now on; NULL for orgs verified before notes
  // existed. Cleared together with verifiedAt.
  verificationNote String? @db.Text
  verifiedBy   User?     @relation("OrganizationVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  status OrganizationStatus @default(ACTIVE)

  // Relations
  donations  Donation[]
  categories CauseCategory[] @relation("OrgCategories")
  newsItems  NewsItem[]
}

// =======================================================
//  Causes & User Interests
// =======================================================

model CauseCategory {
  id            String         @id @default(cuid())
  name          String         @unique
  // URL-safe key, e.g. "space-science" (Discover uses ?category=<slug>; the
  // Every.org cause mapping in src/lib/causes.ts is keyed by it).
  slug          String         @unique
  description   String?
  subcauses     SubCause[]
  organizations Organization[] @relation("OrgCategories")
  userInterests UserInterest[]
}

model SubCause {
  id            String         @id @default(cuid())
  name          String
  categoryId    String
  category      CauseCategory  @relation(fields: [categoryId], references: [id])
  userInterests UserInterest[]
}

model UserInterest {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  subcauseId String?
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id])
  category CauseCategory @relation(fields: [categoryId], references: [id])
  subcause SubCause?     @relation(fields: [subcauseId], references: [id])

  // A user follows each category at most once.
  @@unique([userId, categoryId])
}

// =======================================================
//  User Location (optional)
// =======================================================

model UserLocation {
  id        String  @id @default(cuid())
  userId    String  @unique
  city      String?
  state     String?
  country   String?
  latitude  Float?
  longitude Float?

  user User @relation(fields: [userId], references: [id])
}

// news items
model NewsItem {
  id             String       @id @default(cuid())
  title          String
  content        String
  /// Link to where the organization published this update. The feed shows
  /// only items that have one, so nothing appears without a real source.
  sourceUrl      String?
  /// The update's image: a URL only (we never copy the file), usually the
  /// source page's og:image. Served through /media/news/<id>, which only
  /// serves URLs stored here. Shown with "Image: <source site>" credit.
  imageUrl       String?
  /// Alt text, required whenever there's an image.
  imageAlt       String?
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

// Fixed-window rate-limit counters (D-018). One row per (rule, who, window).
// `keyHash` is an HMAC of the IP, email or user id, never the raw value.
// Expired rows are deleted by the weekly cron.
model RateLimitHit {
  bucket      String
  keyHash     String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  @@id([bucket, keyHash, windowStart])
  @@index([expiresAt])
}
